# Copy to apps/api/.env (gitignored). Values must match the root .env used by compose.
PORT=3003
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=orthopro
DATABASE_PASSWORD=change-me
DATABASE_NAME=orthopro
REDIS_HOST=localhost
REDIS_PORT=6380
# Optional: leave unset for local Redis without auth.
# REDIS_PASSWORD=

# --- Personal data protection (Ley 1581 de 2012) ---------------------------
# Generate real values with:  bun run keys:generate   (appends to .env only if
# missing, never prints them). Or: openssl rand -base64 32
# WARNING: losing ENCRYPTION_KEY makes the encrypted personal data
# UNRECOVERABLE. Back both keys up in a secrets manager; never commit or share
# them. The two keys MUST be different. Rotation needs a re-encryption job.
# AES-256-GCM key for personal data (base64 of exactly 32 bytes).
ENCRYPTION_KEY=
# HMAC-SHA256 key for the cedula blind index (base64 of exactly 32 bytes).
BLIND_INDEX_KEY=
# bcrypt work factor for passwords, integer 10..15 (default 12).
BCRYPT_COST=12

# --- HTTP security ----------------------------------------------------------
# All optional; the defaults below are used when unset.
# development | production | test. In production: HSTS and Secure cookies.
NODE_ENV=development
# Comma separated browser origins allowed by CORS and the unsafe-method Origin
# check (scheme://host[:port], no path, no wildcard).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# SameSite attribute of the auth cookie: strict (default) | lax.
COOKIE_SAMESITE=strict
# Express "trust proxy": false (default), true, or the number of proxy hops in
# front of the API. Needed so rate limiting sees real client IPs behind a proxy.
TRUST_PROXY=false
# Rate limit applied to every route per IP: requests per window (default 60)
# and window length in ms (default 60000). Stricter limits apply to auth routes.
THROTTLE_DEFAULT_LIMIT=60
THROTTLE_TTL_MS=60000
