{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "check-types": "tsc --noEmit",
    "deploy": "TZ=America/Bogota nest deploy",
    "dev": "TZ=America/Bogota nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "TZ=America/Bogota nest start",
    "start:dev": "TZ=America/Bogota nest start --watch",
    "start:debug": "TZ=America/Bogota nest start --debug --watch",
    "start:prod": "TZ=America/Bogota node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "typeorm": "typeorm-ts-node-esm -d src/database/data-source.ts",
    "migration:generate": "bun --env-file=.env node_modules/typeorm/cli.js -d src/database/data-source.ts migration:generate",
    "migration:create": "bun node_modules/typeorm/cli.js migration:create",
    "migration:run": "bun --env-file=.env node_modules/typeorm/cli.js -d src/database/data-source.ts migration:run",
    "migration:revert": "bun --env-file=.env node_modules/typeorm/cli.js -d src/database/data-source.ts migration:revert",
    "migration:show": "bun --env-file=.env node_modules/typeorm/cli.js -d src/database/data-source.ts migration:show",
    "keys:generate": "bun scripts/generate-keys.ts",
    "admin:create": "bun --env-file=.env scripts/admin-create.ts",
    "db:bot-role": "bun --env-file=.env scripts/bot-role.ts",
    "seed:paciente": "bun --env-file=.env scripts/seed-paciente.ts",
    "busqueda:reindexar": "bun --env-file=.env scripts/reindex-paciente-busqueda.ts",
    "db:schema": "podman exec orthopro-postgres pg_dump -U orthopro -d orthopro --schema-only --no-owner --no-privileges | rg -v '^\\\\(un)?restrict' > docs/schema.sql.tmp && (printf -- '-- GENERATED FILE. Do not edit by hand.\\n-- Regenerate with: bun run db:schema (needs infra:up and migrations applied).\\n\\n'; cat docs/schema.sql.tmp) > docs/schema.sql; rm -f docs/schema.sql.tmp",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "@types/nodemailer": "^8.0.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "2.5.0",
    "nodemailer": "^10.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^26.6.6",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
