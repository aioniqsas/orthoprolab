{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "check-types": "tsc --noEmit",
    "deploy": "nest deploy",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "typeorm": "typeorm-ts-node-esm -d src/database/data-source.ts",
    "migration:generate": "bun --env-file=.env node_modules/typeorm/cli.js -d src/database/data-source.ts migration:generate",
    "migration:create": "bun node_modules/typeorm/cli.js migration:create",
    "migration:run": "bun --env-file=.env node_modules/typeorm/cli.js -d src/database/data-source.ts migration:run",
    "migration:revert": "bun --env-file=.env node_modules/typeorm/cli.js -d src/database/data-source.ts migration:revert",
    "migration:show": "bun --env-file=.env node_modules/typeorm/cli.js -d src/database/data-source.ts migration:show",
    "keys:generate": "bun scripts/generate-keys.ts",
    "admin:create": "bun --env-file=.env scripts/admin-create.ts",
    "db:schema": "podman exec orthopro-postgres pg_dump -U orthopro -d orthopro --schema-only --no-owner --no-privileges | rg -v '^\\\\(un)?restrict' > docs/schema.sql.tmp && (printf -- '-- GENERATED FILE. Do not edit by hand.\\n-- Regenerate with: bun run db:schema (needs infra:up and migrations applied).\\n\\n'; cat docs/schema.sql.tmp) > docs/schema.sql; rm -f docs/schema.sql.tmp",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@types/nodemailer": "^8.0.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "2.11.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "2.4.0",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
