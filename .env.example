# Read by `podman compose` (infra) AND shared with apps/api/.env.
# Copy to .env (gitignored) and set a real password.
# Keep DATABASE_* / REDIS_PORT identical in apps/api/.env.
DATABASE_NAME=orthopro
DATABASE_USER=orthopro
DATABASE_PASSWORD=change-me
# Host ports published on 127.0.0.1 (also used by the API as DATABASE_PORT / REDIS_PORT)
DATABASE_PORT=5432
REDIS_PORT=6380
# Optional: leave unset for local Redis without auth.
# REDIS_PASSWORD=

# HTTP security settings (NODE_ENV, CORS_ORIGINS, COOKIE_SAMESITE, TRUST_PROXY,
# THROTTLE_*, JWT_SECRET and the auth settings) also live only in apps/api/.env: see apps/api/.env.example.

# Data-protection keys (ENCRYPTION_KEY, BLIND_INDEX_KEY) and BCRYPT_COST live
# only in apps/api/.env: see apps/api/.env.example. Generate them with
# `bun run keys:generate` (run inside apps/api). Never put them here.
