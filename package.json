{
  "name": "app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "infra:up": "podman compose -f compose.yaml up -d",
    "infra:down": "podman compose -f compose.yaml down",
    "infra:logs": "podman compose -f compose.yaml logs -f",
    "infra:ps": "podman compose -f compose.yaml ps"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "date-fns": "^4.4.0"
  }
}
